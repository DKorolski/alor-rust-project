# Standalone session_gap_replay profile
# Usage:
#   set -a; source ./configs/rt_session_gap_standalone_test.env; set +a
#   cargo run -p strategy-runtime --bin session_gap_replay

REPLAY_ENABLED=true
REPLAY_BARS_CSV_PATH=./paper_bars_2.csv
REPLAY_REFERENCE_TRADES_CSV_PATH=./paper_trades_2.csv
REPLAY_SYMBOL=USDRUBF
REPLAY_PRICE_TOLERANCE=1e-8
REPLAY_STRICT_DEDUP=true
REPLAY_OUTPUT_DIR=./strategy-runtime/replay_out
