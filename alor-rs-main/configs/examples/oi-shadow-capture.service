[Unit]
Description=Read-only IMOEXF OI capture; no model or broker commands
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@USER@
Group=@USER@
ExecStart=/usr/bin/python3 -B @RELEASE@/scripts/oi_shadow_job.py --manifest @CONFIG@/release.json --manifest-sha256 @MANIFEST_SHA@ --mode @MODE@
UMask=0077
StateDirectory=@STATE_NAME@
StateDirectoryMode=0700
ReadOnlyPaths=@RELEASE@ @CONFIG@
ReadWritePaths=/var/lib/@STATE_NAME@
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallFilter=~@mount @reboot @swap @raw-io
# ProtectClock would also deny the required read-only adjtimex query.
MemoryMax=192M
CPUQuota=25%
TasksMax=32
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=600
TimeoutStopSec=10
KillMode=control-group
Restart=no
StandardOutput=journal
StandardError=journal
