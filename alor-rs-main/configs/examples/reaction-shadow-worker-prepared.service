# Non-launchable template. Replace every @...@ token after scoped review.
# No [Install], timer or reboot autostart. Approval is not prepared by this unit.
[Unit]
Description=Isolated reaction shadow worker, explicit admission only
After=network-online.target @SOURCE_UNIT@
ConditionPathExists=@CONFIG@/ADMISSION.json
ConditionPathExists=@CONFIG@/approved-worker.toml
ConditionPathExists=@CONFIG@/admission.env
ConditionPathExists=!@OWNER@/generation
ConditionPathExists=!@OWNER@/generation.supervisor

[Service]
Type=simple
User=@USER@
Group=@USER@
SupplementaryGroups=@SOURCE_GROUP@
EnvironmentFile=@READER_ENV@
EnvironmentFile=-@CONFIG@/admission.env
Environment=TZ=UTC PYTHONDONTWRITEBYTECODE=1
UnsetEnvironment=ALOR_REFRESH_TOKEN SHADOW_ALOR_REFRESH_TOKEN ALOR_ACCESS_TOKEN SHADOW_SOURCE_REDIS_URL REDIS_URL
ExecStartPre=/usr/bin/python3 @SCRIPTS@/reaction_shadow_preflight.py --plan @CONFIG@/plan.json --plan-sha256 @PLAN_SHA@ --stage admission
ExecStart=/usr/bin/python3 @SCRIPTS@/reaction_shadow_service.py create --worker @WORKER@ --spec @CONFIG@/approved-worker.toml --generation @OWNER@/generation --ready-by ${SHADOW_READY_BY} --source-state @SOURCE_STATE@
Restart=no
TimeoutStartSec=60
TimeoutStopSec=25
KillMode=mixed
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=@SOURCE_STATE@ @CONFIG@
ReadWritePaths=@OWNER@
IPAddressDeny=any
IPAddressAllow=@REDIS_IP@/32
RestrictAddressFamilies=AF_INET AF_UNIX
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
MemoryMax=384M
MemorySwapMax=0
CPUQuota=50%
Nice=10
TasksMax=32
StandardOutput=journal
StandardError=journal
