FROM rust:1.85 as builder

WORKDIR /app

ENV RUSTUP_TOOLCHAIN=1.85.0

COPY . .

WORKDIR /app/alor-rs-main

RUN cargo build --release -p strategy-runtime --bin strategy_runtime_runner

FROM debian:12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/alor-rs-main/target/release/strategy_runtime_runner /usr/local/bin/strategy_runtime_runner

ENV RUST_LOG=info,strategy_runtime=info

# Configs are mounted read-only at /configs by docker-compose.
CMD ["strategy_runtime_runner", "--config", "/configs/runtime.paper.toml"]
