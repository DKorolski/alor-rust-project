#
# Example environment file for trading deployment.
# Copy to `.env` on VPS and fill in real values.
#

########################################
# Image / deployment configuration
########################################

# Fixed image tag for live/paper deployment (git SHA or semantic version).
# Example: IMAGE_TAG=abc1234 or IMAGE_TAG=v1.0.0
IMAGE_TAG=CHANGE_ME

# Directory on host with TOML configs (mounted read-only into containers).
CONFIG_DIR=/opt/trading/configs

# Redis connection string used by gateway/runtime.
REDIS_URL=redis://redis:6379/

# Directories for persistent data/artefacts on host.
REDIS_DATA_DIR=/opt/trading/volumes/redis
REPORTS_DIR=/opt/trading/volumes/reports

########################################
# Resource limits (can be tuned per VPS)
########################################

# Memory limits for containers.
GATEWAY_MEM_LIMIT=1500m
RUNTIME_MEM_LIMIT=1500m
REDIS_MEM_LIMIT=512m

# File descriptor limits.
NOFILE_SOFT=65535
NOFILE_HARD=1048576

########################################
# Logging and runtime configuration
########################################

# Rust logging levels.
GATEWAY_RUST_LOG=info,alor_gateway::supervisor=info
RUNTIME_RUST_LOG=info,strategy_runtime=info

# Runtime mode configs.
# For paper:
#   RUNTIME_CONFIG=/configs/runtime.paper.toml
# For live:
#   RUNTIME_CONFIG=/configs/runtime.live.toml
GATEWAY_CONFIG=/configs/gateway.live.toml
RUNTIME_CONFIG=/configs/runtime.paper.toml

########################################
# Alor / trading secrets (DO NOT COMMIT)
########################################

# Alor refresh token or API secret.
ALOR_REFRESH_TOKEN=CHANGE_ME

# Add any other secrets here (tokens, API keys, etc.).

